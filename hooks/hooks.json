{
  "description": "project-brain: injects a small index pointer at session start, and tracks edited files so the index can be refreshed incrementally.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/mark-stale.sh\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
